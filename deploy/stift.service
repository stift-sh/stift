# stift server — systemd unit
# Install: cp stift.service /etc/systemd/system/ && systemctl enable --now stift
# NOTE: deploy/proxmox.sh embeds a copy of this unit; keep the two in sync.
# Data lives in /var/lib/stift (created automatically via StateDirectory).
# Optional settings go in /etc/stift/env, e.g.:
#   STIFT_ADMIN_TOKEN=stf_...
#   STIFT_LISTEN=:8580

[Unit]
Description=stift — self-hosted session store for AI coding agents
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/stift serve --data /var/lib/stift
EnvironmentFile=-/etc/stift/env
DynamicUser=yes
StateDirectory=stift
Restart=on-failure
RestartSec=2

# Hardening: stift only needs its state directory and a listening socket.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
