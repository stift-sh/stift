{
  "openapi": "3.1.0",
  "info": {
    "title": "stift",
    "version": "0.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "stift access token (stf_…)"
      }
    },
    "schemas": {
      "Version": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "api": {
            "type": "integer",
            "description": "API major version"
          }
        },
        "required": [
          "version",
          "api"
        ]
      },
      "Whoami": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "admin": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "admin"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "PushResult": {
        "type": "object",
        "properties": {
          "session": {
            "$ref": "#/components/schemas/Session"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "updated",
              "unchanged"
            ]
          }
        },
        "required": [
          "session",
          "status"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "description": "repo name, for cross-machine matching"
          },
          "repo": {
            "type": "string",
            "description": "normalized git remote URL (secondary signal)"
          },
          "host": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "base": {
            "type": "string",
            "enum": [
              "home",
              "project"
            ],
            "description": "what archive paths are relative to"
          },
          "files": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "sha256": {
            "type": "string"
          },
          "mod_time": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "key",
          "agent",
          "session_id",
          "host",
          "base",
          "files",
          "size",
          "sha256",
          "mod_time",
          "created_at",
          "updated_at"
        ]
      },
      "PushMeta": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "agent": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "project_id": {
            "type": "string",
            "description": "repo name, for cross-machine matching"
          },
          "repo": {
            "type": "string",
            "description": "normalized git remote URL (secondary signal)"
          },
          "host": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "base": {
            "type": "string",
            "enum": [
              "home",
              "project"
            ],
            "description": "what archive paths are relative to"
          },
          "files": {
            "type": "integer"
          },
          "mod_time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "key",
          "agent",
          "session_id",
          "host",
          "base"
        ],
        "description": "JSON; must precede archive"
      },
      "BlobsCheckResponse": {
        "type": "object",
        "properties": {
          "missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "missing"
        ]
      },
      "BlobsCheckRequest": {
        "type": "object",
        "properties": {
          "shas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "shas"
        ]
      },
      "BlobPutResponse": {
        "type": "object",
        "properties": {
          "sha": {
            "type": "string"
          }
        },
        "required": [
          "sha"
        ]
      },
      "Bundle": {
        "type": "object",
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "user",
              "project",
              "org"
            ]
          },
          "agent": {
            "type": "string"
          },
          "project": {
            "type": "string",
            "description": "abs path (scope=project)"
          },
          "name": {
            "type": "string",
            "description": "unit name, 1-3 clean path segments"
          },
          "version": {
            "type": "integer"
          },
          "parent": {
            "type": "integer",
            "description": "version this was based on"
          },
          "host": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "created": {
            "type": "string",
            "format": "date-time"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleFile"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SkillMeta"
            },
            "description": "parsed SKILL.md frontmatter, for listing"
          }
        },
        "required": [
          "scope",
          "agent",
          "name",
          "version",
          "parent",
          "host",
          "author",
          "created",
          "files",
          "skills"
        ]
      },
      "BundleFile": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "relative, forward slashes, no '..' / abs"
          },
          "sha256": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "mode": {
            "type": "integer",
            "description": "only the exec bit is honoured"
          }
        },
        "required": [
          "path",
          "sha256",
          "size",
          "mode"
        ]
      },
      "SkillMeta": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "name",
          "description"
        ]
      },
      "BundleInput": {
        "type": "object",
        "properties": {
          "parent": {
            "type": "integer",
            "description": "version this was based on"
          },
          "host": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BundleFile"
            }
          }
        }
      },
      "TokenInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "admin": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "admin",
          "created_at"
        ]
      },
      "TokenCreated": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "admin": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "admin",
          "created_at",
          "token"
        ]
      },
      "TokenCreateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "admin": {
            "type": "boolean"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string",
                  "enum": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/version": {
      "get": {
        "tags": [
          "meta"
        ],
        "responses": {
          "200": {
            "description": "server version",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Version"
                }
              }
            }
          }
        }
      }
    },
    "/v1/whoami": {
      "get": {
        "tags": [
          "auth"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "the caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Whoami"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions": {
      "post": {
        "tags": [
          "sessions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "meta": {
                    "$ref": "#/components/schemas/PushMeta"
                  },
                  "archive": {
                    "type": "string",
                    "format": "binary",
                    "description": "tar.gz of the session files"
                  }
                },
                "required": [
                  "meta",
                  "archive"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "updated or unchanged",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResult"
                }
              }
            }
          },
          "201": {
            "description": "created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PushResult"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "sessions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "agent",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "project",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "host",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "substring match on title, project or session_id"
            },
            "required": false,
            "description": "substring match on title, project or session_id",
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "sessions, most recently updated first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Session"
                  }
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}": {
      "get": {
        "tags": [
          "sessions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "session id or unambiguous prefix"
            },
            "required": true,
            "description": "session id or unambiguous prefix",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "the session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "sessions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "session id or unambiguous prefix"
            },
            "required": true,
            "description": "session id or unambiguous prefix",
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "deleted"
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/sessions/{id}/archive": {
      "get": {
        "tags": [
          "sessions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "session id or unambiguous prefix"
            },
            "required": true,
            "description": "session id or unambiguous prefix",
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "range",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "the tar.gz archive",
            "content": {
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "206": {
            "description": "partial content",
            "content": {
              "application/gzip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "416": {
            "description": "range not satisfiable"
          }
        }
      }
    },
    "/v1/blobs/check": {
      "post": {
        "tags": [
          "blobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BlobsCheckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "digests the server does not have",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobsCheckResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/blobs/{sha}": {
      "put": {
        "tags": [
          "blobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "hex sha256 of the content"
            },
            "required": true,
            "description": "hex sha256 of the content",
            "name": "sha",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "stored (or already present)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BlobPutResponse"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "411": {
            "description": "Content-Length required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "payload too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "blobs"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "hex sha256 of the content"
            },
            "required": true,
            "description": "hex sha256 of the content",
            "name": "sha",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "blob content",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "missing or invalid bearer token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/bundles": {
      "get": {
        "tags": [
          "bundles"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "scope",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "agent",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "project",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "name",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "HEAD manifest of every matching bundle",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Bundle"
                  }
                }
              }
            }
          },
          "401": {
